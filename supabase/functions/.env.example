# Local values for `supabase functions serve --env-file supabase/functions/.env.example`.
# In production set them with `supabase secrets set`.
APP_URL=http://localhost:5173
INVITE_FROM_EMAIL="Workspace <no-reply@example.com>"
# ALLOWED_ORIGIN defaults to the origin of APP_URL.
# RESEND_API_KEY= (unset: no email is sent, the accept link is returned to the admin)
